+#[derive(Default)]
+struct Output {
+    text: String,
+    // Only host boundaries split ranges, not individual writes or escaped spans.
+    // Host execution is step/output bounded; unfinished hosts are depth bounded.
+    ranges: Vec<std::ops::Range<usize>>,
+    start: usize,
+    len: usize,
+    reordered: bool,
+}
+
+impl Output {
+    fn flush(&mut self) {
+        if self.start != self.text.len() {
+            self.ranges.push(self.start..self.text.len());
+            self.start = self.text.len();
+        }
+    }
+
+    fn shadow(&mut self) -> usize {
+        self.flush();
+        let slot = self.ranges.len();
+        self.ranges.push(0..0);
+        slot
+    }
+
+    fn finish(mut self) -> String {
+        if !self.reordered {
+            return self.text;
+        }
+        self.flush();
+        let mut result = String::with_capacity(self.len);
+        for range in self.ranges {
+            result.push_str(&self.text[range]);
+        }
+        result
+    }
+}
