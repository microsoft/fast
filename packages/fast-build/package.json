{
  "name": "@microsoft/fast-build",
  "version": "0.23.0",
  "description": "CLI and Node.js API for server-side rendering and converting FAST declarative HTML templates.",
  "author": {
    "name": "Microsoft",
    "url": "https://discord.gg/FcSNfg4"
  },
  "homepage": "https://www.fast.design/",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Microsoft/fast.git",
    "directory": "packages/fast-build"
  },
  "bugs": {
    "url": "https://github.com/microsoft/fast/issues/new/choose"
  },
  "exports": {
    "./component-sources.js": {
      "types": "./component-sources.d.ts",
      "default": "./component-sources.js"
    },
    "./native-host.mjs": {
      "types": "./native-host.d.ts",
      "default": "./native-host.mjs"
    },
    "./server.js": {
      "types": "./server.d.ts",
      "default": "./server.js"
    },
    "./bin/fast.js": "./bin/fast.js",
    "./wasm/microsoft_fast_build.js": "./wasm/microsoft_fast_build.js",
    "./wasm/convert/microsoft_fast_convert.js": "./wasm/convert/microsoft_fast_convert.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fast": "bin/fast.js"
  },
  "files": [
    "component-sources.js",
    "component-sources.d.ts",
    "docs/component-sources/DESIGN.md",
    "native-host.mjs",
    "native-host.d.ts",
    "native-build.json",
    "build-native-host.mjs",
    "server.js",
    "server.d.ts",
    "bin",
    "get-package-json.js",
    "wasm/microsoft_fast_build.js",
    "wasm/microsoft_fast_build_bg.wasm",
    "wasm/microsoft_fast_build.d.ts",
    "wasm/microsoft_fast_build_bg.wasm.d.ts",
    "wasm/convert/microsoft_fast_convert.js",
    "wasm/convert/microsoft_fast_convert_bg.wasm",
    "wasm/convert/microsoft_fast_convert.d.ts",
    "wasm/convert/microsoft_fast_convert_bg.wasm.d.ts"
  ],
  "scripts": {
    "build:native-host": "node build-native-host.mjs",
    "test:native-host": "node --require ./test/native-addon.cjs --expose-gc --test test/native-host.test.mjs",
    "test:native-package": "node --test test/native-package.test.mjs",
    "build": "node build-wasm.cjs && node build-native-host.mjs ../../crates/microsoft-fast-build/target/node-host",
    "test:node": "node --require ./test/native-addon.cjs --expose-gc --test \"test/**/*.test.mjs\"",
    "bench:server": "node test/performance/server-renderer.mjs",
    "profile:server": "node test/performance/server-renderer.mjs --profile-phase=all --profile-directory=./profiles",
    "test:fixtures:convert": "node --test \"test/fixtures/convert/*.test.mjs\""
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "optionalDependencies": {
    "@microsoft/fast-build-darwin-arm64": "0.23.0",
    "@microsoft/fast-build-darwin-x64": "0.23.0",
    "@microsoft/fast-build-linux-arm64": "0.23.0",
    "@microsoft/fast-build-linux-x64": "0.23.0",
    "@microsoft/fast-build-win32-arm64": "0.23.0",
    "@microsoft/fast-build-win32-x64": "0.23.0"
  },
  "beachball": {
    "disallowedChangeTypes": [
      "prerelease",
      "major"
    ]
  }
}
